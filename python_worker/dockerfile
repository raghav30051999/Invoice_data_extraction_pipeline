# Base image: lightweight Python
FROM python:3.11-slim

# System dependencies: Tesseract OCR engine + English & Telugu language data
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-tel \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Worker code (main.py, ocr_engine.py)
COPY . .

# Shared folder mount point (input/output files)
RUN mkdir -p /files/input /files/output

EXPOSE 8000

# Start the FastAPI worker
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]